# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.env
.venv/
venv/
ENV/

# Node
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vite/

# React/Vite
frontend/dist/
frontend/.vite/

# Data
data/raw/*.csv
data/processed/*.json
!data/sample/

